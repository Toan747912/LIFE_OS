{
  "manifest_version": 3,
  "name": "VI Subtitle Translator & TTS",
  "version": "3.0.0",
  "description": "Tự động phát hiện phụ đề video trên mọi trang web, dịch sang tiếng Việt và đọc to.",

  "permissions": [
    "scripting"
  ],

  "host_permissions": [
    "*://*/*",
    "http://127.0.0.1:8000/*"
  ],

  "content_scripts": [
    {
      "_comment": "phim.nguonc.com — adapter riêng, không chạy generic",
      "matches": ["*://phim.nguonc.com/*"],
      "js": ["core.js", "sites/phim.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "_comment": "Mọi trang khác (YouTube, Coursera, ...) — generic adapter",
      "matches": ["*://*/*"],
      "exclude_matches": ["*://phim.nguonc.com/*"],
      "js": ["core.js", "sites/generic.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
