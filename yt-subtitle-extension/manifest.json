{
  "manifest_version": 3,
  "name": "VI Subtitle Translator & TTS",
  "version": "2.0.0",
  "description": "Tự động phát hiện phụ đề video trên mọi trang web, dịch sang tiếng Việt và đọc to.",

  "permissions": [
    "scripting"
  ],

  "host_permissions": [
    "*://*/*",
    "http://127.0.0.1:8000/*"
  ],

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
